<h1>ログイン</h1>

<%= form_with url: login_path do |form| %>
  <div>
    <%= form.label :login_id, "ログイン ID" %>
    <%= form.text_field :login_id, required: true %>
  </div>

  <div>
    <%= form.label :password, "パスワード" %>
    <%= form.password_field :password, required: true %>
  </div>

  <%= form.submit "ログイン" %>
<% end %>

<%= link_to "新規登録", sign_up_path %>
