<h1>新規登録</h1>

<% if @user.errors.any? %>
  <div>
    <p>登録できませんでした。</p>
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @user, url: sign_up_path do |form| %>
  <div>
    <%= form.label :login_id, "ログイン ID" %>
    <%= form.text_field :login_id, required: true %>
  </div>

  <div>
    <%= form.label :password, "パスワード" %>
    <%= form.password_field :password, required: true %>
  </div>

  <%= form.submit "登録" %>
<% end %>
